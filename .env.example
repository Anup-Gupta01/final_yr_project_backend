# Copy this file to .env and fill in real values. Never commit .env.

# Server
NODE_ENV=development
PORT=5000

# Database — either a local server or a MongoDB Atlas cluster.
#   local:  mongodb://127.0.0.1:27017/staysphere
#   atlas:  mongodb+srv://<user>:<password>@<cluster>.mongodb.net/staysphere?retryWrites=true&w=majority
# With Atlas, add your IP under Network Access or the connection times out.
MONGODB_URI=mongodb://127.0.0.1:27017/staysphere

# Auth — use a long random string in any deployed environment
JWT_SECRET=replace-me-with-a-long-random-secret
JWT_EXPIRES_IN=7d

# Comma-separated list of frontend origins allowed to call this API
CLIENT_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:4173

# Seed admin account (used only by "npm run seed:admin")
SEED_ADMIN_NAME=Platform Admin
SEED_ADMIN_EMAIL=admin@staysphere.in
SEED_ADMIN_PHONE=9000000000
SEED_ADMIN_PASSWORD=change-this-password

# Optional: server the test suites run against. They create and DROP
# databases, so the database name is always forced to a *test* name.
# Defaults to mongodb://127.0.0.1:27017
# MONGODB_TEST_URI=mongodb://127.0.0.1:27017

# ── Razorpay (payments) ─────────────────────────────────────────────────
# Test-mode keys: Razorpay Dashboard -> switch to Test Mode -> Account &
# Settings -> API Keys -> Generate Test Key. Use rzp_test_ keys for demos.
# Without these, the Pay button shows "payments not configured".
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Dashboard -> Webhooks -> add https://<your-api>/api/payments/webhook with
# events payment.captured, payment.failed, order.paid, and copy the secret.
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_CURRENCY=INR

# ── Links and uploads ───────────────────────────────────────────────────
# Frontend URL used in emails (password reset). Defaults to the first CLIENT_ORIGINS entry.
CLIENT_URL=http://localhost:5173
# Public URL of this API, used for uploaded image links. Defaults to the request host.
PUBLIC_API_URL=

# ── Email through Resend (optional) ─────────────────────────────────────
# Without a key, emails are skipped; in development the password-reset
# link is shown on the reset screen instead.
RESEND_API_KEY=
MAIL_FROM=StaySphere <onboarding@resend.dev>
